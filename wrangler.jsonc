// Cloudflare Worker for the playtest site (see docs/DEPLOY.md). Serves the built game from
// dist/ and runs worker/index.ts for /api/feedback (playtest notes, stored in KV).
// "name" must match the Worker's name in the Cloudflare dashboard, and the KV "id" is the
// ares-feedback namespace's ID (Storage & Databases, KV); neither is secret.
{
  "name": "project-ares",
  "main": "worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    { "binding": "FEEDBACK", "id": "769abdbfa6b2473b8c04adac6f6e7d06" }
  ],
  "observability": { "enabled": true }
}
